[Unit]
Description=qoder2api dual bridge (CN 8963 + Global 8964) + web console 3588
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/qoder2api
Environment=QODER2API_CONSOLE_PASSWORD=CHANGE_ME
Environment=HOME=/root
# 单进程双桥：--cn-port=0 只跑国际版，--global-port=0 只跑国内版
ExecStart=/opt/qoder2api/qoder2api --bind=0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
